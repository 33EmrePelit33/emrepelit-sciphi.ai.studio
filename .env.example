# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_OWNER_PASSWORD: Optional server-side owner lock password for emrepelit39@gmail.com.
# If unset, the owner can configure a scrypt-hashed password directly from the Admin Lock UI.
ADMIN_OWNER_PASSWORD=""

# Optional Transactional Email / SMTP Relay Configuration for 24/7 Q&A Escalation:
# Configure either RESEND_API_KEY or SMTP_WEBHOOK_URL for direct transactional delivery.
RESEND_API_KEY=""
SMTP_FROM_EMAIL="Sci-Phil Archive <noreply@emrepelit-sciphi.ai.studio>"
SMTP_WEBHOOK_URL=""
SMTP_WEBHOOK_SECRET=""


